{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theorem.dev/schemas/recognition.v1.schema.json",
  "title": "Theorem Problem Recognition Schema v1",
  "type": "object",
  "required": ["schema_version", "problems"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "problems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "problem_number",
          "subject_category",
          "statement_markdown"
        ],
        "additionalProperties": false,
        "properties": {
          "problem_number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "subproblem_number": {
            "type": ["string", "null"]
          },
          "subject_category": {
            "type": "string",
            "enum": ["mathematics", "physics", "other"]
          },
          "field": {
            "type": ["string", "null"]
          },
          "statement_markdown": {
            "type": "string",
            "minLength": 1
          },
          "given_conditions": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "target_objective": {
            "type": ["string", "null"]
          },
          "source_pages": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 },
            "default": []
          },
          "figure_refs": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "uncertainties": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          }
        }
      }
    }
  }
}
